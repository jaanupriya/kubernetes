version: 0.2

phases:

  install:
    runtime-versions:
      java: corretto17
    commands:
      - echo Installing Maven
      - yum install -y maven
      - mvn -version

  pre_build:
    commands:
      - echo Code checkout completed

  build:
    commands:
      - echo Build started
      - mvn clean install

  post_build:
    commands:
      - echo Build completed

artifacts:
  files:
    - target/*.jar
